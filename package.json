{
  "name": "simple-mc-launcher",
  "version": "1.0.8",
  "description": "Простой Minecraft-лаунчер со сборками, которые обновляются через GitHub",
  "main": "src/main/index.js",
  "author": "Simple MC Launcher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/smoke.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@xmcl/core": "2.16.3",
    "@xmcl/installer": "5.4.0",
    "7zip-bin": "^5.2.0",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.1"
  }
}
